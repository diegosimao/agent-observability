# --- LangSmith (required to see the dashboards) ---
# Create a key at https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=support-agent-prod
# For an EU-region account, uncomment:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- LLM ---
# auto   = use Gemini if GOOGLE_API_KEY is set, otherwise mock
# mock   = simulated LLM (free, deterministic enough for a demo)
# gemini = force Gemini
# local  = local Hugging Face model or LoRA adapter (see LOCAL_MODEL)
AGENT_MODE=auto
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# LOCAL_MODEL=finetune/adapters/qwen-support-lora

# "Deploy" version recorded on every trace (useful to compare releases)
APP_VERSION=1.3.0
