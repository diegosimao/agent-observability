# --- LangSmith (obrigatório para ver os dashboards) ---
# Crie a chave em https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=agente-suporte-prod
# Para conta na região EU, descomente:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- LLM ---
# auto  = usa Gemini se GOOGLE_API_KEY existir, senão mock
# mock  = LLM simulado (grátis, determinístico o suficiente para demo)
# gemini = força Gemini
AGENT_MODE=auto
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Versão "do deploy" gravada em cada trace (útil para comparar releases)
APP_VERSION=1.3.0
